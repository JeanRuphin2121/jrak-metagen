# Copy this file to .env and fill in the values before running:
#   docker compose -f docker/docker-compose.yml up -d

# Database
METAGEN_DB_PASSWORD=change_me_in_production

# JWT signing secret (min 32 random characters)
METAGEN_JWT_SECRET=change_this_secret_to_a_random_32_char_string

# Initial admin password
METAGEN_ADMIN_PASSWORD=change_me_in_production

# AI assistant (optional — set METAGEN_AI_ENABLED=true to activate)
METAGEN_AI_ENABLED=false
ANTHROPIC_API_KEY=
