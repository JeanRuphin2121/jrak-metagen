# =============================================================
# Metagen Platform — environment variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# =============================================================

# ── Database ───────────────────────────────────────────────
METAGEN_DB_URL=jdbc:postgresql://localhost:5432/metagen
METAGEN_DB_USER=metagen
METAGEN_DB_PASSWORD=metagen
METAGEN_DB_POOL_SIZE=10

# ── Security ───────────────────────────────────────────────
# Change these in production!
METAGEN_JWT_SECRET=change-this-secret-in-production-min-32-chars
METAGEN_JWT_EXPIRATION_MS=86400000    # 24 hours in ms
METAGEN_ADMIN_USER=admin
METAGEN_ADMIN_PASSWORD=changeme

# ── Server ─────────────────────────────────────────────────
PORT=8080

# ── AI assistant (optional) ────────────────────────────────
# Set METAGEN_AI_ENABLED=true and provide your Anthropic API key
# to activate the AI proposal feature.
METAGEN_AI_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-...
METAGEN_AI_MODEL=claude-sonnet-4-6

# ── Studio ─────────────────────────────────────────────────
METAGEN_STUDIO_ENABLED=true
